#!/bin/sh
set -eu

repo_dir=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cd "$repo_dir"

task=${1:-check}
if [ "$#" -gt 0 ]; then shift; fi

case "$task" in
    fmt)
        go fmt ./...
        (cd experiments/sqlite && go fmt ./...)
        ;;
    test) exec go test ./... "$@" ;;
    race) exec go test -p 1 -race -timeout=15m ./... "$@" ;;
    race-group) exec ./scripts/race-group "$@" ;;
    race-census)
        if [ "$#" -ne 0 ]; then echo "race-census accepts no operands" >&2; exit 2; fi
        exec ./scripts/race-group census
        ;;
    run) exec go run ./cmd/rydd "$@" ;;
    package) exec go run ./cmd/rydd-package "$@" ;;
    check)
        unformatted=$(gofmt -l cmd internal experiments scripts)
        if [ -n "$unformatted" ]; then
            echo 'Run ./scripts/dev fmt to format these files:' >&2
            printf '%s\n' "$unformatted" >&2
            exit 1
        fi
        go vet -p 1 ./...
        go test -p 1 ./...
        mkdir -p dist
        go build -trimpath -o dist/rydd ./cmd/rydd
        ;;
    build-all)
        mkdir -p dist
        for target_os in darwin linux; do
            for target_arch in arm64 amd64; do
                GOOS="$target_os" GOARCH="$target_arch" CGO_ENABLED=0 \
                    go build -trimpath -o "dist/rydd-$target_os-$target_arch" ./cmd/rydd
            done
        done
        ;;
    sqlite-check)
        cd experiments/sqlite
        go vet ./...
        go test ./...
        CGO_ENABLED=1 go test -tags sqlite_cgo ./...
        ;;
    sqlite-bench)
        cd experiments/sqlite
        go run . "$@"
        CGO_ENABLED=1 go run -tags sqlite_cgo . "$@"
        ;;
    *)
        echo "Unknown task: $task" >&2
        echo 'Tasks: check, fmt, test, race, race-group, race-census, run, package, build-all, sqlite-check, sqlite-bench' >&2
        exit 2
        ;;
esac
